{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laaa.com/contracts/bov/sources-1.0.0.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "deal_id", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "deal_id": {"type": "string"},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "ref", "retrieved_at", "retrieval_status", "meaningful_content", "facts_supported", "access_limitation", "conflict_notes", "gap_notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
        "type": {"enum": ["assessor", "mls", "costar", "owner_docs", "owner_pm_site", "listing_portal", "gov", "other"]},
        "url": {"type": ["string", "null"]}, "ref": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "retrieval_status": {"enum": ["retrieved", "blocked", "unavailable", "not_applicable"]},
        "meaningful_content": {"type": "boolean"},
        "evidence_artifact": {"type": ["object", "null"], "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
        "facts_supported": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "access_limitation": {"type": ["string", "null"]}, "conflict_notes": {"type": "array", "items": {"type": "string"}}, "gap_notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
