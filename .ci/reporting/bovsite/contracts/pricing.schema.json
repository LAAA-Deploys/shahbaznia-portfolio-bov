{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laaa.com/contracts/bov/pricing-1.0.0.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "deal_id", "decision", "operations", "assumptions", "sensitivity", "risks", "what_would_change_it", "evidence", "model"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "deal_id": {"type": "string"},
    "decision": {"type": "object", "additionalProperties": false, "required": ["exact_price", "range_low", "range_high", "confidence", "price_per_unit", "price_per_sf", "cap_rate", "cap_rate_basis", "grm", "grm_basis", "expense_ratio", "rent_upside"], "properties": {"exact_price": {"type": "number", "exclusiveMinimum": 0}, "range_low": {"type": "number", "exclusiveMinimum": 0}, "range_high": {"type": "number", "exclusiveMinimum": 0}, "confidence": {"enum": ["high", "medium", "low"]}, "price_per_unit": {"description": "null ONLY on a land deal, where there are no units to divide by. price_per_sf has been nullable for the same reason since 1.0.0.", "type": ["number", "null"]}, "price_per_sf": {"type": ["number", "null"]}, "cap_rate": {"description": "Publish control and pricing cap as a FRACTION: 0.06288 means 6.288%. null withholds the subject cap from the page. A percent-shaped value is refused.", "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1}, "cap_rate_basis": {"type": "string", "minLength": 1}, "grm": {"type": ["number", "null"]}, "grm_basis": {"type": "string", "minLength": 1}, "expense_ratio": {"description": "null ONLY on a land deal. The ratio is operating expenses over gross operating income, so it is undefined wherever pricing.operations is null. Never null it merely because expenses are unknown on an income property: that is an incomplete underwrite, not an inapplicable metric.", "type": ["number", "null"]}, "rent_upside": {"type": ["number", "null"]}}},
    "operations": {"type": "object", "additionalProperties": false, "required": ["current", "normalized", "proforma"], "properties": {"current": {"oneOf": [{"$ref": "#/$defs/operation"}, {"type": "null"}], "description": "null ONLY on a land deal whose value does not rest on the subject's own operations. scripts/bov.py restores the floor for every other deal_type. Never null it to avoid publishing an inconvenient NOI: an operating statement that is merely incomplete belongs in financials.json with an annual_estimate basis, not here as an absence."}, "normalized": {"oneOf": [{"$ref": "#/$defs/operation"}, {"type": "null"}]}, "proforma": {"oneOf": [{"$ref": "#/$defs/operation"}, {"type": "null"}]}}},
    "assumptions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "description", "support_refs", "estimated_value_effect"], "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "support_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "estimated_value_effect": {"type": "number"}}}},
    "sensitivity": {"type": "object", "additionalProperties": false, "required": ["grid_ref", "scenarios"], "properties": {"grid_ref": {"type": "string"}, "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}}}},
    "risks": {"type": "array", "items": {"type": "string"}}, "what_would_change_it": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["subject_profile_ref", "sale_comp_ids", "rent_comp_ids", "underwriting_ref", "required_metrics"], "properties": {"subject_profile_ref": {"type": "string"}, "sale_comp_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "rent_comp_ids": {"description": "Empty ONLY on a land deal, which has no units to compare. pricing/check_pricing_evidence.py restores the floor for every other deal_type and refuses a NON-empty list on a land deal.", "type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string"}}, "underwriting_ref": {"type": "string"}, "required_metrics": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["price_per_unit", "price_per_sf", "cap_rate", "grm"]}}}},
    "model": {"description": "null ONLY on a land deal, whose supporting workbook is a land residual model rather than the M&M Multifamily template this block describes. The BINDING IS NOT LOST when it is null: scripts/bov.py then requires the workbook named by deal.workspace_layout.model_workbook to be carried in sources.json as an evidence_artifact whose sha256 matches the file on disk, which is the same guarantee by a different route. Never null it on a deal that has an M&M model.", "type": ["object", "null"], "additionalProperties": false, "required": ["template_id", "workbook_path", "workbook_sha256", "named_range_fingerprint", "recalc_verified_at", "recalc_method", "outputs"], "properties": {"template_id": {"const": "M&M Multifamily Model v1.1.0"}, "workbook_path": {"type": "string"}, "workbook_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "named_range_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "recalc_verified_at": {"type": "string", "format": "date-time"}, "recalc_method": {"const": "excel_open_recalculate_save"}, "outputs": {"type": "object", "additionalProperties": false, "required": ["price", "unit_count", "gross_scheduled_rent_current", "gross_scheduled_rent_proforma", "operating_expenses_current", "operating_expenses_proforma", "noi_current", "noi_proforma", "vacancy_credit_current", "vacancy_credit_proforma"], "properties": {"price": {"type": "number"}, "unit_count": {"type": "number"}, "gross_scheduled_rent_current": {"type": "number"}, "gross_scheduled_rent_proforma": {"type": "number"}, "operating_expenses_current": {"type": "number"}, "operating_expenses_proforma": {"type": "number"}, "noi_current": {"type": "number"}, "noi_proforma": {"type": "number"}, "vacancy_credit_current": {"type": "number"}, "vacancy_credit_proforma": {"type": "number"}}}}}
  },
  "$defs": {"operation": {"type": "object", "additionalProperties": false, "required": ["gross_scheduled_rent", "vacancy", "credit_loss", "other_income", "operating_expenses", "noi"], "properties": {"gross_scheduled_rent": {"type": "number"}, "vacancy": {"type": "number", "minimum": 0}, "credit_loss": {"type": "number", "minimum": 0}, "other_income": {"type": "number"}, "operating_expenses": {"type": "number", "minimum": 0}, "noi": {"type": "number"}}}, "scenario": {"type": "object", "additionalProperties": false, "required": ["name", "noi", "cap_rate", "value"], "properties": {"name": {"type": "string"}, "noi": {"type": "number"}, "cap_rate": {"description": "Scenario cap rate as a FRACTION; value = noi / cap_rate.", "type": "number", "exclusiveMinimum": 0, "maximum": 1}, "value": {"type": "number", "exclusiveMinimum": 0}}}}
}
